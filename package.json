{
  "name": "forj",
  "description": "SQLite ORM and Query Builder whitout dependencies",
  "version": "0.1.10",
  "type": "module",
  "main": "src/index.ts",
  "files": ["src"],
  "exports": {
    ".": "./src/index.ts",
    "./d1": "./src/d1/index.ts",
    "./d1/types": "./src/d1/types.ts",
    "./dynamodb": "./src/dynamodb/index.ts",
    "./dynamodb/types": "./src/dynamodb/types.ts",
    "./migrate": "./src/migrations/index.ts"
  },
  "scripts": {
    "bench": "tsx tests/benchmark/*.bench.ts",
    "build": "tsup",
    "-prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1003.0",
    "@aws-sdk/lib-dynamodb": "^3.1003.0",
    "pathe": "^2.0",
    "pluralize": "^8.0",
    "t0n": "^0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/pluralize": "^0.0.33",
    "@cloudflare/workers-types": "^4.20260113.0",
    "bun-types": "^1.3.8",
    "terser": "^5.46.0",
    "tiny-glob": "^0.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "author": "Zunq <open-source@zunq.com>",
